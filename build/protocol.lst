 154:App/Src/protocol.c **** static bool Flash_ProgramData(uint32_t address, const uint8_t *data, uint32_t length)
 155:App/Src/protocol.c **** {
 156:App/Src/protocol.c ****     for (uint32_t i = 0; i < length; i += 8)
 157:App/Src/protocol.c ****     {
 158:App/Src/protocol.c ****         uint64_t doubleword;
 159:App/Src/protocol.c ****         memcpy(&doubleword, &data[i], 8);
 160:App/Src/protocol.c **** 
 161:App/Src/protocol.c ****         if (HAL_FLASH_Program(FLASH_TYPEPROGRAM_DOUBLEWORD, address + i, doubleword) != HAL_OK)
 162:App/Src/protocol.c ****         {
 163:App/Src/protocol.c ****             return false;
 164:App/Src/protocol.c ****         }
 165:App/Src/protocol.c ****     }
 166:App/Src/protocol.c **** 
 167:App/Src/protocol.c ****     return true;
 168:App/Src/protocol.c **** }
 169:App/Src/protocol.c **** 
 170:App/Src/protocol.c **** static bool Flash_WriteBlock(uint32_t address, const uint8_t *data, uint32_t length)
 171:App/Src/protocol.c **** {
 172:App/Src/protocol.c ****     HAL_FLASH_Unlock();
 173:App/Src/protocol.c **** 
 174:App/Src/protocol.c ****     bool erase_ok = Flash_ErasePage(address);
 175:App/Src/protocol.c ****     bool write_ok = false;
 176:App/Src/protocol.c **** 
 177:App/Src/protocol.c ****     if (erase_ok)
 178:App/Src/protocol.c ****     {
 179:App/Src/protocol.c ****         write_ok = Flash_ProgramData(address, data, length);
 180:App/Src/protocol.c ****     }
 181:App/Src/protocol.c **** 
 182:App/Src/protocol.c ****     HAL_FLASH_Lock();
 183:App/Src/protocol.c **** 
 184:App/Src/protocol.c ****     return (erase_ok && write_ok);
 185:App/Src/protocol.c **** }
