  90:App/Src/protocol.c **** bool StartTransfer()
  91:App/Src/protocol.c **** {
  92:App/Src/protocol.c **** 	protocol_state = PROTOCOL_STATE_RECEIVING_DATA;
  93:App/Src/protocol.c **** 	return true;
  94:App/Src/protocol.c **** }
  95:App/Src/protocol.c **** bool CheckCRC()
  96:App/Src/protocol.c **** {
  97:App/Src/protocol.c **** 	if(expected_bytes == 1)
  98:App/Src/protocol.c **** 	{
  99:App/Src/protocol.c **** 	  expected_bytes = CMD_SIZE + PACKET_SIZE + CRC_SIZE;
 100:App/Src/protocol.c **** 	  return false;
 101:App/Src/protocol.c **** 	}
 102:App/Src/protocol.c **** 	uint16_t received_crc = (uint16_t)(rx_buffer[1 + PACKET_SIZE] | (rx_buffer[1 + PACKET_SIZE + 1] <<
 103:App/Src/protocol.c **** 	uint16_t calculated_crc = CalculateChecksum(&rx_buffer[1], PACKET_SIZE);
 104:App/Src/protocol.c **** 
 105:App/Src/protocol.c **** 	if (received_crc != calculated_crc)
 106:App/Src/protocol.c **** 	{
 107:App/Src/protocol.c **** 	  printf("CRC POGRESAN! primljen=0x%04X, izracunat=0x%04X\r\n", received_crc, calculated_crc);
 108:App/Src/protocol.c **** 	  /* NE piši u flash, NE pomiči offset - blok je oštećen */
 109:App/Src/protocol.c **** 	  return true;   /* poruka JEST kompletna, samo je odbijena */
 110:App/Src/protocol.c **** 	}
 111:App/Src/protocol.c **** 
 112:App/Src/protocol.c **** 	if (Flash_WriteBlock(current_flash_offset, &rx_buffer[1], PACKET_SIZE))
 113:App/Src/protocol.c **** 	{
 114:App/Src/protocol.c **** 	  current_flash_offset += PACKET_SIZE;
 115:App/Src/protocol.c **** 	}
 116:App/Src/protocol.c **** 	else
 117:App/Src/protocol.c **** 	{
 118:App/Src/protocol.c **** 	  printf("Flash write GRESKA!\r\n");
 119:App/Src/protocol.c **** 	}
 120:App/Src/protocol.c **** 
 121:App/Src/protocol.c **** 	return true;
 122:App/Src/protocol.c **** }
 123:App/Src/protocol.c **** bool EndTransfer()
 124:App/Src/protocol.c **** {
 125:App/Src/protocol.c **** 	Bootloader_JumpToApplication();
 126:App/Src/protocol.c **** 	return true;
 127:App/Src/protocol.c **** }
