 129:App/Src/protocol.c **** static bool Flash_ErasePage(uint32_t address)
 130:App/Src/protocol.c **** {
 131:App/Src/protocol.c ****     uint32_t current_page = (address - START_ADDRESS) / FLASH_PAGE_SIZE;
 132:App/Src/protocol.c **** 
 133:App/Src/protocol.c ****     if (current_page == last_erased_page)
 134:App/Src/protocol.c ****     {
 135:App/Src/protocol.c ****         return true;
 136:App/Src/protocol.c ****     }
 137:App/Src/protocol.c **** 
 138:App/Src/protocol.c ****     FLASH_EraseInitTypeDef erase_init;
 139:App/Src/protocol.c ****     uint32_t page_error;
 140:App/Src/protocol.c **** 
 141:App/Src/protocol.c ****     erase_init.TypeErase = FLASH_TYPEERASE_PAGES;
 142:App/Src/protocol.c ****     erase_init.Page = current_page;
 143:App/Src/protocol.c ****     erase_init.NbPages = 1;
 144:App/Src/protocol.c **** 
 145:App/Src/protocol.c ****     if (HAL_FLASHEx_Erase(&erase_init, &page_error) != HAL_OK)
 146:App/Src/protocol.c ****     {
ARM GAS  C:\Users\Domagoj\AppData\Local\Temp\cc2NYfZ6.s 			page 4


 147:App/Src/protocol.c ****         return false;
 148:App/Src/protocol.c ****     }
 149:App/Src/protocol.c **** 
 150:App/Src/protocol.c ****     last_erased_page = current_page;
 151:App/Src/protocol.c ****     return true;
 152:App/Src/protocol.c **** }
