  33:App/Src/protocol.c **** static void ProcessCompleteMessage(void);
  34:App/Src/protocol.c **** 
  35:App/Src/protocol.c **** void Protocol_ProcessByte(uint8_t *data, uint32_t len)
  36:App/Src/protocol.c **** {
  37:App/Src/protocol.c ****     for (uint32_t i = 0; i < len; i++)
  38:App/Src/protocol.c ****     {
  39:App/Src/protocol.c ****         if (rx_buffer_filled < sizeof(rx_buffer))
  40:App/Src/protocol.c ****         {
  41:App/Src/protocol.c ****             rx_buffer[rx_buffer_filled++] = data[i];
  42:App/Src/protocol.c ****         }
  43:App/Src/protocol.c **** 
  44:App/Src/protocol.c ****         if (rx_buffer_filled == expected_bytes)
  45:App/Src/protocol.c ****         {
  46:App/Src/protocol.c ****             ProcessCompleteMessage();
  47:App/Src/protocol.c ****         }
  48:App/Src/protocol.c ****     }
  49:App/Src/protocol.c **** }
  50:App/Src/protocol.c **** 
  51:App/Src/protocol.c **** static void ProcessCompleteMessage(void)
  52:App/Src/protocol.c **** {
  53:App/Src/protocol.c ****     uint8_t cmd = rx_buffer[0];
  54:App/Src/protocol.c ****     bool complete = true;
  55:App/Src/protocol.c **** 
  56:App/Src/protocol.c ****     switch (cmd)
  57:App/Src/protocol.c ****     {
  58:App/Src/protocol.c ****     case CMD_SET_PACKET_SIZE:
  59:App/Src/protocol.c ****     	complete = SetPacketSize();
  60:App/Src/protocol.c ****     	break;
  61:App/Src/protocol.c **** 
  62:App/Src/protocol.c ****     case CMD_START_TRANSFER:
  63:App/Src/protocol.c ****         complete = StartTransfer();
  64:App/Src/protocol.c ****         break;
  65:App/Src/protocol.c **** 
  66:App/Src/protocol.c ****     case CMD_DATA_BLOCK_WITH_CRC:
  67:App/Src/protocol.c ****     	complete = CheckCRC();
  68:App/Src/protocol.c ****         break;
  69:App/Src/protocol.c **** 
  70:App/Src/protocol.c ****     case CMD_END_TRANSFER:
  71:App/Src/protocol.c ****         complete = EndTransfer();
  72:App/Src/protocol.c ****         break;
  73:App/Src/protocol.c **** 
  74:App/Src/protocol.c ****     default:
  75:App/Src/protocol.c ****         printf("Nepoznata komanda: 0x%02X\r\n", cmd);
  76:App/Src/protocol.c ****         break;
  77:App/Src/protocol.c ****     }
  78:App/Src/protocol.c ****     if (complete)
  79:App/Src/protocol.c **** 	{
  80:App/Src/protocol.c **** 	  rx_buffer_filled = 0;
  81:App/Src/protocol.c **** 	  expected_bytes = 1;
  82:App/Src/protocol.c **** 	}
  83:App/Src/protocol.c **** }
  84:App/Src/protocol.c **** 
  85:App/Src/protocol.c **** bool SetPacketSize()
  86:App/Src/protocol.c **** {
  87:App/Src/protocol.c **** 	packet_size = PACKET_SIZE;
  88:App/Src/protocol.c **** 	return true;
  89:App/Src/protocol.c **** }
