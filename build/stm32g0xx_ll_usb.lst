 469:Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_ll_usb.c **** #endif /* (USE_USB_DOUBLE_BUFFER == 1U) */
 470:Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_ll_usb.c **** 
 471:Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_ll_usb.c ****   /* IN endpoint */
 472:Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_ll_usb.c ****   if (ep->is_in == 1U)
 473:Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_ll_usb.c ****   {
 474:Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_ll_usb.c ****     /* Multi packet transfer */
 475:Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_ll_usb.c ****     if (ep->xfer_len > ep->maxpacket)
 476:Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_ll_usb.c ****     {
 477:Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_ll_usb.c ****       len = ep->maxpacket;
 478:Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_ll_usb.c ****     }
 479:Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_ll_usb.c ****     else
