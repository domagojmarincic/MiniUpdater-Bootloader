 463:Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_ll_usb.c **** HAL_StatusTypeDef USB_EPStartXfer(USB_DRD_TypeDef *USBx, USB_DRD_EPTypeDef *ep)
 464:Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_ll_usb.c **** {
 465:Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_ll_usb.c ****   uint32_t len;
 466:Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_ll_usb.c **** #if (USE_USB_DOUBLE_BUFFER == 1U)
 467:Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_ll_usb.c ****   uint16_t pmabuffer;
