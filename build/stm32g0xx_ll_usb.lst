 484:Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_ll_usb.c ****     /* configure and validate Tx endpoint */
 485:Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_ll_usb.c ****     if (ep->doublebuffer == 0U)
 486:Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_ll_usb.c ****     {
 487:Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_ll_usb.c ****       USB_WritePMA(USBx, ep->xfer_buff, ep->pmaadress, (uint16_t)len);
 488:Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_ll_usb.c ****       PCD_SET_EP_TX_CNT(USBx, ep->num, len);
 489:Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_ll_usb.c ****     }
 490:Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_ll_usb.c **** #if (USE_USB_DOUBLE_BUFFER == 1U)
 491:Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_ll_usb.c ****     else
 492:Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_ll_usb.c ****     {
 493:Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_ll_usb.c ****       /* double buffer bulk management */
 494:Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_ll_usb.c ****       if (ep->type == EP_TYPE_BULK)
 495:Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_ll_usb.c ****       {
ARM GAS  C:\Users\Domagoj\AppData\Local\Temp\ccdbAIX0.s 			page 47


 496:Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_ll_usb.c ****         if (ep->xfer_len_db > ep->maxpacket)
 497:Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_ll_usb.c ****         {
 498:Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_ll_usb.c ****           /* enable double buffer */
 499:Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_ll_usb.c ****           PCD_SET_BULK_EP_DBUF(USBx, ep->num);
 500:Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_ll_usb.c **** 
 501:Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_ll_usb.c ****           /* each Time to write in PMA xfer_len_db will */
 502:Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_ll_usb.c ****           ep->xfer_len_db -= len;
 503:Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_ll_usb.c **** 
 504:Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_ll_usb.c ****           /* Fill the two first buffer in the Buffer0 & Buffer1 */
 505:Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_ll_usb.c ****           if ((PCD_GET_ENDPOINT(USBx, ep->num) & USB_EP_DTOG_TX) != 0U)
 506:Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_ll_usb.c ****           {
